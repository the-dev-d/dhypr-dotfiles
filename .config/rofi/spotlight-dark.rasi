@import "colors.rasi"

* {
    font: "Comfortaa SemiBold 11";

    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    background-color: @bg;

    location: center;
    width: 640;
    border-radius: 8px;
    border: 1px;
    border-color: @separator;
}

inputbar {
    font: "Comfortaa 12";
    padding: 12px;
    spacing: 12px;
    children: [ icon-search, entry ];
}

icon-search {
    expand: false;
    filename: "search";
    size: 28px;
}

icon-search, entry, element-icon, element-text {
    vertical-align: 0.5;
}

entry {
    font: inherit;

    placeholder: "Search";
    placeholder-color: @fg-muted;
}

message {
    border: 2px 0 0;
    border-color: @separator;
    background-color: @separator;
}

textbox {
    padding: 8px 24px;
}

listview {
    lines: 10;
    columns: 1;

    fixed-height: false;
    border: 1px 0 0;
    border-color: @separator;
}

element {
    padding: 8px 16px;
    spacing: 16px;
    background-color: transparent;
}

element normal active {
    text-color: @active-fg;
}

element alternate active {
    text-color: @active-fg;
}

element selected normal,
element selected active {
    background-color: @selected-bg;
    text-color: @selected-fg;
}

element-icon {
    size: 1em;
}

element-text {
    text-color: inherit;
}
